{
  "port": 8080,
  "db_path": "mash.db",
  "services": ["tuoni", "seshat", "observer", "caretaker", "boatman", "gateway"],
  "providers": [
    {
      "id": "ssd-primary",
      "type": "local",
      "path": "./data/ssd_primary",
      "capabilities": {
        "latency": "low",
        "reliability": "high"
      }
    },
    {
      "id": "hdd-backup",
      "type": "local",
      "path": "./data/hdd_backup",
      "capabilities": {
        "latency": "high",
        "reliability": "medium"
      }
    }
  ],
  "policies": [
    {
      "id": "replicate-all",
      "type": "replicate",
      "target": "object",
      "value": "2",
      "priority": 1
    }
  ]
}
